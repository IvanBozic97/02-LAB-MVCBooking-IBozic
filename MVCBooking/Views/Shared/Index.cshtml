@model List<MVCBooking.Models.HotelBooking>

<h2>All Bookings</h2>

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Guest Name</th>
                <th>Room Number</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Id</td>
                    <td>@booking.GuestName</td>
                    <td>@booking.RoomNumber</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No bookings yet.</p>
}
